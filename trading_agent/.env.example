# --- Alpaca paper trading (always required) ---
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# --- LLM backend selection ---
# Choose your provider: "anthropic" (cloud) or "local" (OpenAI-compatible server)
LLM_PROVIDER=anthropic

# Option A: Anthropic cloud (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-sonnet-4-6

# Option B: Local model via OpenAI-compatible server (LLM_PROVIDER=local)
# Ollama example (default port shown):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=not-needed
# Pick LLM_MODEL by available RAM:
#   8 GB  -> qwen2.5:3b   (recommended for MacBook Air 8GB)
#   16 GB -> qwen2.5:14b
#   24 GB+-> qwen2.5:32b
# LLM_MODEL=qwen2.5:3b
#
# Other servers:
#   LM Studio  -> LLM_BASE_URL=http://localhost:1234/v1
#   llama.cpp  -> LLM_BASE_URL=http://localhost:8080/v1
#   vLLM       -> LLM_BASE_URL=http://localhost:8000/v1
#
# Option C: NVIDIA NIM free tier (LLM_PROVIDER=local) — big open models,
# hosted free on NVIDIA GPUs. Get a key at https://build.nvidia.com
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-your_key_here
# LLM_MODEL=meta/llama-3.1-70b-instruct
